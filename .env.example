# Host folder mounted at /opt/mount/project in the api container. Put your
# image datasets underneath it -- labels and the prompt bank are written into
# a hidden .ctflow/ subfolder inside each dataset folder, nothing else to
# point at. Windows: DATA_DIR=C:/Code/datasets   Linux: DATA_DIR=/mnt/nas/datasets
DATA_DIR=../data

WEB_PORT=3000
# Only used by docker-compose.override.yml (development), which publishes the
# API on the host so you can curl it. In production nothing outside the compose
# network talks to it -- the browser goes through the Next.js proxy in `web`.
# The endpoint reference is docs/API_REFERENCE.md; there is no Swagger UI.
API_PORT=8000
# Likewise development-only: the port PostgreSQL is published on for the test
# harness and adminer. 5433 because a distro postgres often already holds 5432.
DB_PORT=5433

# --- GPU ---------------------------------------------------------------
# The GPU belongs to the `vpe` service (the inference sidecar), not to `api`:
# docker-compose.yml requests an NVIDIA GPU there and backend/inference/Dockerfile
# builds against a CUDA torch wheel. No NVIDIA GPU on this host? Either delete
# that `deploy.reservations` block, or rebuild CPU-only:
#   docker compose build --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu vpe
# Nothing to set here -- this is a note, not an env var.

# --- database (T-21) ----------------------------------------------------
# Label/box storage lives in PostgreSQL (the prompt bank -- embeddings -- is
# unaffected, still a file under each project's .ctflow/_bank/). Required:
# docker-compose.yml refuses to start the `db` service without it. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- signing in: REQUIRED (T-27) -----------------------------------------
# Set EITHER the OIDC block below (what people use) OR LABEL_TOOL_USERS here
# (the CI and development path). With neither, the API refuses to start --
# projects have owners and every box has an author, and a server nobody signs
# in to would record all of them as nobody.
#
# Generate a local entry with:
#   docker compose run --rm api /app/api -hash-password alice 'their password'
# Several users: comma-separated. Never commit a filled-in .env.
LABEL_TOOL_USERS=
# Signs the session cookie. Unset = a fresh random one per restart, i.e.
# everyone is signed out whenever the container restarts.
#   python -c "import secrets; print(secrets.token_hex(32))"
LABEL_TOOL_SECRET=
MAX_UPLOAD_MB=25

# --- company login (OIDC, same flow as corpus-core) ----------------------
# The real login. Set all four, or fall back to LABEL_TOOL_USERS above --
# one of the two is mandatory. OIDC wins where both are set. FRONTEND_URL must
# exactly match the public URL registered with the provider; its callback is
# /entry/callback.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ENDPOINT=
FRONTEND_URL=http://localhost:3000

# UID that owns DATA_DIR on a Linux host, so the non-root container can write
# labels into it. Ignored by Docker Desktop on Windows/macOS.
#   APP_UID=1000
APP_UID=1000
