# Host folder mounted at /data in the api container. Put your image datasets
# underneath it -- labels and the prompt bank are written into a hidden
# .ctflow/ subfolder inside each dataset folder, nothing else to point at.
# Windows: DATA_DIR=C:/Code/datasets   Linux: DATA_DIR=/mnt/nas/datasets
DATA_DIR=../data

WEB_PORT=3000
# Swagger UI at http://localhost:8000/docs, raw spec at /openapi.json --
# see docs/API_REFERENCE.md.
API_PORT=8000

# --- GPU ---------------------------------------------------------------
# docker-compose.yml requests an NVIDIA GPU by default (see the api service's
# `deploy.reservations` block) and the image is built against a CUDA torch
# wheel. No NVIDIA GPU on this host? Either delete that block, or rebuild
# CPU-only: docker compose build --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu api
# Nothing to set here -- this is a note, not an env var.

# --- database (T-21) ----------------------------------------------------
# Label/box storage lives in PostgreSQL now (the prompt bank -- embeddings --
# is unaffected, still a file under each project's .ctflow/_bank/). Required:
# docker-compose.yml refuses to start the `db` service without it. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- optional: multi-user (T-12/T-13) ------------------------------------
# Leave LABEL_TOOL_USERS empty and the tool works exactly as before: no login
# screen, and upload refuses to run. Fill it in and every endpoint needs a
# session. Generate an entry with:
#   python -m backend.services.auth alice 'their password'
# Several users: comma-separated. Never commit a filled-in .env.
LABEL_TOOL_USERS=
# Signs the session cookie. Unset = a fresh random one per restart, i.e.
# everyone is signed out whenever the container restarts.
#   python -c "import secrets; print(secrets.token_hex(32))"
LABEL_TOOL_SECRET=
MAX_UPLOAD_MB=25

# UID that owns DATA_DIR on a Linux host, so the non-root container can write
# labels into it. Ignored by Docker Desktop on Windows/macOS.
#   APP_UID=1000
APP_UID=1000
