# The Go API service. Build context is this repo's root, see docker-compose.yml.
# Named .api, not .go: Go tooling parses every *.go path in the tree as source.
#
# This is what `api` becomes. During the port it serves the routes it has and
# proxies the rest to the `legacy` service (LEGACY_URL) -- see
# docs/REFACTOR_PLAN.md phase 2 and cmd/api/main.go.

FROM golang:1.26-alpine AS build
WORKDIR /src

# Any .crt dropped in certs/ becomes trusted at build time, same as the Python
# images: a corporate TLS proxy intercepts the module download too.
COPY certs/ /usr/local/share/ca-certificates/
RUN apk add --no-cache ca-certificates && update-ca-certificates

# Module files first so a source-only change reuses the download layer.
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/
# CGO off so the result runs on a base image with no libc of its own.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.22
# ca-certificates for outbound TLS; busybox already provides the wget the
# healthcheck uses, which is why this is alpine rather than distroless -- a
# scratch image has nothing that can perform its own healthcheck.
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/api /app/api

# The checkpoint catalog is shared with the inference sidecar rather than
# compiled in, so that adding a checkpoint is one edit and not two that can
# disagree -- see internal/models. It is data, not code, so it is copied here
# rather than embedded.
COPY backend/models.json /app/backend/models.json

ENV MODELS_DIR=/models \
    MODELS_CATALOG=/app/backend/models.json \
    LABEL_TOOL_MODE=vm \
    LABEL_TOOL_VM_ROOT=/opt/mount/project \
    PORT=8000

# NFR-07 -- not root. Must match the UID that owns DATA_DIR on a Linux host and
# the other services' UID, since all of them write under it:
#   docker compose build --build-arg APP_UID=$(id -u)
ARG APP_UID=1000
RUN adduser -D -u ${APP_UID} app && chown -R app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=10 \
    CMD wget -q -O- http://localhost:8000/api/config >/dev/null || exit 1
CMD ["/app/api"]
