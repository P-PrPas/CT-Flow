# cp to .env next to docker-compose.yml, fill in, then `docker compose up -d`.

# Image tag to run. `latest` tracks every push and lets cr-watchtower
# auto-update (see ../../README.md); pin it to an exact tag (e.g.
# v0.1.0-rc1) to freeze this deploy and opt out of auto-update.
TAG=latest

POSTGRES_PASSWORD=

# Absolute path on the VM's host filesystem where labeled images/datasets
# live -- bind-mounted into both api and vpe so they see the same files.
# Same variable name as the dev docker-compose.yml at the repo root.
DATA_DIR=

# Signs the session cookie -- set this (any random string) so a redeploy
# doesn't sign everyone out. Required, unlike the dev compose's optional one.
LABEL_TOOL_SECRET=

# OAuth. Leave unset only if you're intentionally running local-login (see
# README.md) -- fine for a demo VM, not for anything with real users.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ENDPOINT=

# LABEL_TOOL_USERS and MAX_UPLOAD_MB are optional -- same defaults as dev.
LABEL_TOOL_USERS=
MAX_UPLOAD_MB=
